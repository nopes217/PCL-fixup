<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:PCL"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <local:MyCard Margin="0,15" Title="今日人品">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LabJrrpResult" Margin="0,0,0,12" TextWrapping="Wrap" FontSize="14"
                               Text="点击下方按钮，看看你今天的人品值是多少。" />
                    <local:MyButton x:Name="BtnJrrp" Grid.Row="1" Text="测测今天的人品" Height="34" MinWidth="150"
                                    HorizontalAlignment="Left" ColorType="Highlight" />
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="内存优化">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap" Opacity="0.8"
                               Text="释放被占用的物理内存，让游戏获得更多可用内存。优化前请先关闭占用较大的程序。" />
                    <TextBlock x:Name="LabMemoryResult" Grid.Row="1" Margin="0,0,0,12" TextWrapping="Wrap" FontSize="13" />
                    <local:MyButton x:Name="BtnMemoryOptimize" Grid.Row="2" Text="开始内存优化" Height="34" MinWidth="150"
                                    HorizontalAlignment="Left" ColorType="Highlight" />
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="清理垃圾">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap" Opacity="0.8"
                               Text="清理 PCL 运行过程中产生的临时文件、日志与缓存。清理不会影响存档、Mod 和游戏本体。" />
                    <TextBlock x:Name="LabRubbishResult" Grid.Row="1" Margin="0,0,0,12" TextWrapping="Wrap" FontSize="13" />
                    <local:MyButton x:Name="BtnRubbishClear" Grid.Row="2" Text="立即清理" Height="34" MinWidth="150"
                                    HorizontalAlignment="Left" ColorType="Highlight" />
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="自定义下载">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,14" TextWrapping="Wrap" Opacity="0.8"
                               Text="填入文件网址与保存路径，点击开始即可下载。" />
                    <TextBlock Grid.Row="1" Margin="0,0,0,6" Text="下载网址" Opacity="0.75" FontSize="12" />
                    <local:MyTextBox x:Name="TextCustomUrl" Grid.Row="2" Margin="0,0,0,12" Height="32"
                                     HintText="例如 https://example.com/file.zip" />
                    <TextBlock Grid.Row="3" Margin="0,0,0,6" Text="保存路径" Opacity="0.75" FontSize="12" />
                    <Grid Grid.Row="4" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextCustomPath" Height="32"
                                         HintText="例如 D:\Downloads\file.zip（留空则下载到 PCL 下载文件夹）" />
                        <local:MyButton x:Name="BtnBrowsePath" Grid.Column="1" Text="浏览…" Height="32" MinWidth="80"
                                        Margin="10,0,0,0" />
                    </Grid>
                    <local:MyButton x:Name="BtnCustomDownload" Grid.Row="5" Text="开始下载" Height="34" MinWidth="150"
                                    HorizontalAlignment="Left" ColorType="Highlight" />
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="回声洞">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LabRandomHint" Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap" FontSize="14"
                               Text="点一下，随机听一句社区留言。" />
                    <local:MyButton x:Name="BtnRandomHint" Grid.Row="1" Text="换一句" Height="34" MinWidth="150"
                                    HorizontalAlignment="Left" />
                </Grid>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
